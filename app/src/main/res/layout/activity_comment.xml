<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".CommentActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarComments"
        android:layout_width="match_parent"
        app:title=" "
        android:background="@color/colorSurface"
        android:elevation="0dp"
        android:layout_height="64dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back_black_24dp"
                android:background="@drawable/bg_stat_card"
                android:padding="8dp"
                android:tint="@color/colorTextPrimary"
                android:onClick="goBack"
                android:layout_marginRight="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Comments"
                android:textColor="@color/colorTextPrimary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Divider -->
    <View
        android:id="@+id/dividerComments"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/toolbarComments"
        android:background="@color/colorDivider"/>

    <!-- Comment Input Bar at Bottom -->
    <LinearLayout
        android:id="@+id/commentInputBar"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:background="@color/colorSurface"
        android:layout_alignParentBottom="true"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:layout_height="wrap_content">

        <!-- Input Field -->
        <EditText
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="10dp"
            android:hint="Write a comment..."
            android:inputType="textMultiLine"
            android:textSize="14sp"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorTextHint"
            android:id="@+id/txtAddComment"
            android:background="@drawable/bg_comment_input"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"/>

        <!-- Send Button -->
        <ImageButton
            android:layout_width="44dp"
            android:src="@drawable/ic_send_black_24dp"
            android:background="@drawable/bg_send_btn"
            android:layout_gravity="center_vertical"
            android:onClick="addComment"
            android:tint="@color/colorWhite"
            android:padding="10dp"
            android:id="@+id/btnAddComment"
            android:layout_height="44dp"/>

    </LinearLayout>

    <!-- Top Divider for Input Bar -->
    <View
        android:id="@+id/dividerInput"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/commentInputBar"
        android:background="@color/colorDivider"/>

    <!-- Comments RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:id="@+id/recyclerComments"
        android:layout_below="@+id/dividerComments"
        android:layout_above="@+id/dividerInput"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:layout_height="match_parent"/>

</RelativeLayout>